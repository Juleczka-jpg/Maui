<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp9.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label Text="Nagłówek strony"
                   FontSize="26"
                   TextColor="#191970"/>

            <VerticalStackLayout Spacing="10">

                <Label Text="Wybierz ocenę: "/>
                <Slider x:Name="GradeSlider"
                        Minimum="1"
                        Maximum="6"
                        Value="3"
                        ValueChanged="OnGradeChanged"/>
                
            </VerticalStackLayout>

            <Label x:Name="ResultLabel"
                   Text="Ocena: 3"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
