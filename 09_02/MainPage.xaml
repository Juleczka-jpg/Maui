<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_09_02.MainPage"
             Title="NumerZdajacego">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label Text="Podaj nazwę produktu: "/>
            <Entry x:Name="ShoppingEntry" />
            <Button x:Name="AddButton" 
                    Text="Dodaj"
                    Clicked="OnAddClicked"/>

            <CollectionView x:Name="WidokListy">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" 
                               FontSize="18" 
                               Padding="10" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Usuń zaznaczone" 
                    Clicked="OnDeleteClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
