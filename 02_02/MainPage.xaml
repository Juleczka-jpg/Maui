<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_02_02.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            
            <Label
                x:Name="ResultLabel"
                Text="Kalkulator powitań"
                HorizontalOptions="Center" />

            <Label
                Text="Podaj miasto:"/>
            
            <Entry
                x:Name="MiastoEntry"
                />

            <Button
                Text="Pokaż"
                x:Name="PokazButton" 
                Clicked="OnShowButtonClicked"
                HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
