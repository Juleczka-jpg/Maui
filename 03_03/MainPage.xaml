<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="_03_03.MainPage"
             Title="numerzdajacego">

    <Grid Padding="25" RowSpacing="15" ColumnSpacing="10">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="Auto" /> 
            <RowDefinition Height="Auto" /> 

        </Grid.RowDefinitions>


        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="Auto" /> 
            <ColumnDefinition Width="*" /> 

        </Grid.ColumnDefinitions>


        <Label Text="Formularz zamówienia" 
               FontSize="24" 
               HorizontalOptions="Center" 
               Grid.Row="0" 
               Grid.Column="0" 
               Grid.ColumnSpan="2" />

        <Label Text="Produkt:" 
               VerticalOptions="Center" 
               Grid.Row="1" 
               Grid.Column="0" />

        <Entry x:Name="ProductEntry" 
               Placeholder="Wpisz produkt" 
               Grid.Row="1" 
               Grid.Column="1" />

        <Label Text="Ilość:" 
               VerticalOptions="Center" 
               Grid.Row="2" 
               Grid.Column="0" />

        <Entry x:Name="QuantityEntry" 
               Placeholder="Wpisz ilość" 
               Grid.Row="2" 
               Grid.Column="1" />

        <Label Text="Adres dostawy:" 
               VerticalOptions="Center" 
               Grid.Row="3" 
               Grid.Column="0" />

        <Entry x:Name="DeliveryAddressEntry" 
               Placeholder="Wpisz adres dostawy" 
               Grid.Row="3" 
               Grid.Column="1" />

        <Button Text="Złóż zamówienie" 
                Clicked="OnOrderClicked" 
                Grid.Row="4" 
                Grid.Column="0" 
                Grid.ColumnSpan="2" />

    </Grid>

</ContentPage>
